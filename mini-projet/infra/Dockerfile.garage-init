# Image d'initialisation de Garage : le binaire officiel, avec le shell que son image ne contient pas.
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

COPY --from=dxflrs/garage:v2.5.0@sha256:677e5b758e4425a325b811c425c026bf35a4bf42f7ddbaa773de3f4fd779a5a5 /garage /usr/local/bin/garage

# La construction échoue si le binaire ne tourne pas ici, ou s'il n'a pas la bonne version
RUN garage --version | grep -q "v2.5.0"
