# Image Airflow du mini projet : uv lance chaque script avec ses propres dépendances, à côté de celles d'Airflow.
FROM apache/airflow:3.3.2@sha256:e9982ad3f49a60418622e1baf80c34b0daf3fa5091a336cb5ee61f0cdd189371

# L'image contient déjà un uv plus ancien, en tête du PATH : on le remplace pour avoir la même version que sur la machine
COPY --from=ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 /uv /uvx /home/airflow/.local/bin/

# La construction échoue si un outil attendu manque, ou si uv n'a pas la bonne version
RUN uv --version | grep -q "^uv 0.13.6" && curl --version

# L'ingestion tourne dans le processus de la tâche : le provider Kafka et PyIceberg s'installent à côté d'Airflow,
# aux versions de ses contraintes
RUN uv pip install \
    --constraint https://raw.githubusercontent.com/apache/airflow/constraints-3.3.2/constraints-3.13.txt \
    apache-airflow-providers-apache-kafka==2.0.0 "pyiceberg[pyarrow]==0.12.0"

# Créés ici pour que les volumes appartiennent à l'utilisateur airflow
RUN mkdir -p /opt/airflow/metadata /opt/airflow/.cache/uv
